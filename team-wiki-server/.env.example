# ─── Knowledge Base ───────────────────────────
# Path to the markdown vault directory
VAULT_PATH=./test-vault

# Optional: choose a different config file at runtime
# ENV_FILE=.env.sqlite

# MCP server port
PORT=3100

# ─── AI Provider (DeepSeek as default) ────────
# Your DeepSeek API key
AI_API_KEY=your-api-key-here
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-v4-flash

# For OpenAI (override the above):
# AI_API_KEY=sk-xxxxx
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o

# ─── Auth ────────────────────────────────────
# Bearer token for authentication (leave empty to disable)
AUTH_TOKEN=
# JWT_SECRET=

# ─── Database ────────────────────────────────
DB_PROVIDER=sqlite
DB_PATH=./data/chat.sqlite
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamwiki
# DB_SSL=false
# DB_POOL_MAX=20

# ─── MCP ───────────────────────────────────────
# Set to false to disable the MCP protocol server (for external AI tools)
MCP_ENABLED=true

# ─── File Watching ───────────────────────────
WATCH_DEBOUNCE_MS=2000
IGNORE_DOTFILES=true
IGNORE_PATTERNS=.obsidian/**

# ─── Graph ────────────────────────────────────
INDEX_CONCURRENCY=10
MAX_TRAVERSAL_DEPTH=5
MAX_GRAPH_NODES=200
